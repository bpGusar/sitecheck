# Скопируйте этот файл в settings.env и поменяйте нужное.
# Строки с # в начале не действуют.

# Адрес и порт страницы.
# 127.0.0.1 — открывается только на этом компьютере.
# 0.0.0.0   — открывается и с других устройств в сети (тогда включите AUTH=basic).
HOST=127.0.0.1
PORT=8090

# Вход на страницу:
#   none      — без пароля;
#   basic     — логин и пароль из AUTH_USER и AUTH_PASSWORD (окно браузера);
#   authentik — вход делает authentik перед reverse proxy, страница показывает, кто вошёл, и кнопку «Выйти».
AUTH=none
AUTH_USER=
AUTH_PASSWORD=

# Папка для баз и истории проверок. Пусто — папка data рядом с приложением.
DATA_DIR=
